# Copy to .env and fill in what you need. Replay mode needs none of these.

# Live mode: Google Gemini structured outputs (Stages 1, 2, 4, 7, 8, 9, 10, 11).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional override for Stage 11 synthesis only (empty = GEMINI_MODEL).
GEMINI_SYNTHESIS_MODEL=
GEMINI_TIMEOUT_SEC=20
# Set from Google's current price list at deploy time; used for DAILY_LLM_BUDGET_USD.
LLM_PRICE_INPUT_PER_MTOK_USD=0
LLM_PRICE_OUTPUT_PER_MTOK_USD=0

# Live mode: SEC requires an app name plus a real, monitored contact email.
SEC_EDGAR_USER_AGENT="AtlasResearch/1.0 (you@example.com)"

# Optional sources. Empty values skip the source and record a stated gap.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
FINNHUB_API_KEY=

# Storage.
ATLAS_DB_PATH=data/atlas_state.db
ATLAS_GOLDEN_DIR=data/golden_runs

# Live-mode spend protection; replays are unlimited.
MAX_LIVE_RUNS_PER_HOUR_PER_IP=10
DAILY_LLM_BUDGET_USD=5.00
